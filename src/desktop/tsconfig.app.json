{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "strict": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@desktop/*": ["src/*"],
      "@web/*": ["../web-user/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../web-user/src/**/*.ts", "../web-user/src/**/*.vue"]
}
